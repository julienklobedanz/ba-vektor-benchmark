# Kopieren nach .env und ggf. anpassen.
# Digests: Manifest-List (linux/amd64) von Docker Hub, Stand 2026-10-16.
# Nach lokalem Pull verifizieren mit:
#   docker image inspect --format '{{index .RepoDigests 0}}' <image>:<tag>
#
# RAM-Budget: Container-Limit(e) + Client-Prozess ≤ Host-RAM
# (CCX23: 16 GB → Default MEM_LIMIT=10g lässt Spielraum für OS + Python-Client).

# --- Host / CPU-Trennung (CCX23 Default) ---
MEM_LIMIT=10g
CPUSET_DB=0-2
CPUSET_CLIENT=3

# MongoDB: Summe mongod+mongot = Messbudget (Default 50/50 von 10g)
# Phase-0-Testaufteilungen bei Gesamt 8g: 50/50 und 30/70 — siehe README
MEM_LIMIT_MONGOD=5g
MEM_LIMIT_MONGOT=5g
# WiredTiger-Cache (GB), typisch ~50 % von MEM_LIMIT_MONGOD
WIREDTIGER_CACHE_GB=2
# mongot JVM-Heap (Xms=Xmx); Container-Limit sollte Heap + ~30 % Overhead sein
MONGOT_JVM_HEAP=2g

# --- Image-Tags (gepinnt) ---
PGVECTOR_IMAGE=pgvector/pgvector:0.8.7-pg17
PGVECTOR_DIGEST=sha256:ac08538c6f8b9904c33c8224c5e5706dbe760aca29db1d096972b4052c22a75d

MONGO_IMAGE=mongodb/mongodb-community-server:8.3.13-ubi8
MONGO_DIGEST=sha256:ae2a9dd906100e4485be83860ad5474c5daa7be399d5d9019ea8516e3f791cc6

MONGOT_IMAGE=mongodb/mongodb-community-search:1.70.5
MONGOT_DIGEST=sha256:d6ead1b6b012a6cc9446701a1b367e361b9337ba69d9da999586c63ea7103445

QDRANT_IMAGE=qdrant/qdrant:v1.19.2
QDRANT_DIGEST=sha256:b7b0444c4c351c970b98e90a6f89c2ee4287c65b44e52b4cb503fa5b2aa927ad

# --- Postgres ---
POSTGRES_PASSWORD=bench_dummy_pg
POSTGRES_USER=bench
POSTGRES_DB=bench

# --- MongoDB / mongot (Phase 0 ohne Access Control auf mongod) ---
MONGOT_USER=mongotUser
MONGOT_PASSWORD=bench_dummy_mongot
# Passwortdatei: secrets/mongot_password (ohne Newline, chmod 400) — siehe scripts/setup-vm.sh
